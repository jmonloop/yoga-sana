---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import Section from '../components/Section.astro';
import Foto from '../components/Foto.astro';
import WaButton from '../components/WaButton.astro';
import { CTAS } from '../data/site';
---

<Base
  title="Yoga online desde toda España, 30 € al mes — Yoga Sana"
  description="Yoga online desde cualquier punto de España: una clase nueva cada semana, cuatro al mes, una hora de práctica más quince minutos de relajación, para repetir cuando quieras. 30 € al mes."
>
  <Section eyebrow="Desde donde estés">
    <Banda columnas="1fr 26rem">
      <h1>Yoga online</h1>
      <p class="lead">
        Una clase nueva cada semana para practicar a tu ritmo, desde cualquier punto de
        España y sin depender de cuadrar horarios.
      </p>
      <WaButton {...CTAS.unirmeOnline} />
      <Foto
        slot="foto"
        nombre="yoga-al-aire-libre"
        sizes="(min-width: 60rem) 26rem, 92vw"
        alt="Mujer haciendo una extensión de espalda al aire libre, junto al río."
        eager
      />
    </Banda>
  </Section>

  <Section title="Qué incluye" muted animar>
    <ul class="incluye" role="list">
      <li>Una clase nueva cada semana.</li>
      <li>Cuatro clases al mes.</li>
      <li>Una hora de práctica más quince minutos de relajación.</li>
      <li>Las repites las veces que quieras, el día y la hora que te vengan bien.</li>
    </ul>
    <p class="precio"><strong>30 €</strong> al mes</p>
    <p class="entrega">Cada semana te hago llegar la clase nueva directamente.</p>
    <WaButton {...CTAS.unirmeOnline} />
  </Section>

  <Section title="¿Te queda alguna duda?" animar>
    <p class="intro">
      Escríbeme por WhatsApp y te cuento cómo funciona antes de que te apuntes a nada.
    </p>
    <WaButton {...CTAS.contacto} />
  </Section>
</Base>

<style>
  .incluye {
    display: grid;
    gap: 0.75rem;
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .incluye li {
    position: relative;
    padding-left: 1.75rem;
  }

  .incluye li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--salvia);
    border-radius: var(--radius-circle);
  }

  .precio {
    margin: 2rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.2;
    color: var(--tinta);
  }

  .entrega {
    margin: 0.25rem 0 2rem;
    color: var(--oliva-oscuro);
  }
</style>
