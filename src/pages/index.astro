---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import Section from '../components/Section.astro';
import Foto from '../components/Foto.astro';
import WaButton from '../components/WaButton.astro';
import { actividadesDe, nombresEnumerados } from '../components/actividad';
import { resumenHorario } from '../components/horario-grid';
import { CTAS, INSTAGRAM, INSTAGRAM_URL } from '../data/site';
import {
  ajuste,
  NOTA_PIE_POR_DEFECTO,
  sinPuntoFinal,
  SNAPSHOT,
  TAGLINE_POR_DEFECTO,
} from '../data/snapshot';

const clases = actividadesDe(SNAPSHOT.actividades, 'yoga');
const talleres = actividadesDe(SNAPSHOT.actividades, 'taller');
const sanergia = SNAPSHOT.actividades.find(({ nombre }) => nombre === 'Sanergía');
const resumen = resumenHorario(SNAPSHOT.horarios);

const tagline = sinPuntoFinal(ajuste('tagline', TAGLINE_POR_DEFECTO));
const notaPie = ajuste('nota_pie', NOTA_PIE_POR_DEFECTO);
const mes = ajuste('mes');
---

<Base
  title="Yoga Sana — Clases de yoga en Catarroja (València)"
  description="Clases de yoga, talleres y Sanergía en Catarroja (València), presenciales u online. Tu espacio para respirar, conectar y reconectar contigo. Escríbeme por WhatsApp."
>
  <Section eyebrow="Un lugar para ti">
    <Banda columnas="1fr 26rem">
      <h1>Yoga Sana, en Catarroja</h1>
      <p class="lead">{tagline}.</p>
      <p>Clases, talleres y sesiones individuales, presenciales u online.</p>
      <WaButton {...CTAS.empezar} />
      <Foto
        slot="foto"
        nombre="yoga-al-aire-libre"
        sizes="(min-width: 60rem) 26rem, min(92vw, 40rem)"
        alt="Mujer haciendo una extensión de espalda al aire libre junto al río, a la luz del atardecer."
        eager
      />
    </Banda>
  </Section>

  <Section title="¿Qué puedes encontrar?" muted animar>
    <p class="intro">
      Todo lo que hago se puede hacer presencial en Catarroja u online, desde donde estés.
    </p>
    <ul class="teasers rejilla" role="list">
      {
        clases.length > 0 && (
          <li>
            <h3 class="titulo">Clases de yoga</h3>
            <p>{nombresEnumerados(clases)}</p>
            <p>Cada semana, en grupo y para todos los niveles.</p>
            <p class="teaser-cta">
              <a class="boton" href="/clases-de-yoga">
                Ver las clases
              </a>
            </p>
          </li>
        )
      }
      {
        talleres.length > 0 && (
          <li>
            <h3 class="titulo">Talleres y experiencias</h3>
            <p>{nombresEnumerados(talleres)}</p>
            <p>Encuentros puntuales, cada uno con su propio ritmo.</p>
            <p class="teaser-cta">
              <a class="boton" href="/talleres-y-experiencias">
                Ver los talleres
              </a>
            </p>
          </li>
        )
      }
      <li>
        <h3 class="titulo">Sesiones individuales</h3>
        <p>
          La gestión emocional y la Sanergía también se hacen a solas, en sesión individual y
          a tu ritmo.
        </p>
        <p class="teaser-cta"><WaButton {...CTAS.sesionIndividual} variant="secondary" /></p>
      </li>
    </ul>
  </Section>

  <Section title="Horario semanal" eyebrow={mes} animar>
    {
      resumen && (
        <p class="intro">
          Hay clases los {resumen.dias}: la primera empieza a las {resumen.primera} y la última a
          las {resumen.ultima}. En la página de clases lo tienes completo, clase a clase: toca
          la que te interese y me escribes por WhatsApp para reservar plaza, o descárgatelo
          como imagen para guardártelo.
        </p>
      )
    }
    <p class="intro apunte">{notaPie}</p>
    <a class="boton" href="/clases-de-yoga#horario">Ver horarios</a>
  </Section>

  <Section title="Nuestro centro" muted animar>
    <Banda columnas="1fr 28rem">
      <p>
        Una sala tranquila en Catarroja para practicar sin prisa, con sitio de sobra para
        extender la esterilla.
      </p>
      <p>
        Aquí tienes esterillas, bolsters, mantas y bloques a mano: tú solo tienes que venir.
      </p>
      <Foto
        slot="foto"
        nombre="centro-sala"
        sizes="(min-width: 60rem) 28rem, 92vw"
        alt="La sala del centro con esterillas verdes extendidas sobre el suelo de madera y una lámpara de sal junto a la pared."
      />
    </Banda>
  </Section>

  <Section title="Yoga online" animar>
    <p class="intro">
      Si no puedes venir a Catarroja, o prefieres practicar en casa: una clase nueva cada
      semana, cuatro al mes, de una hora más quince minutos de relajación, para repetirlas
      cuando quieras. <strong>30 €</strong> al mes.
    </p>
    <a class="boton" href="/online">Quiero unirme</a>
  </Section>

  {
    sanergia && (
      <Section title={sanergia.nombre} muted animar>
        <p class="intro">
          {sinPuntoFinal(sanergia.descripcion)}. Se reserva presencial en Catarroja u online.
        </p>
        <a class="boton" href="/sanergia">
          Saber más sobre Sanergía
        </a>
      </Section>
    )
  }

  <Section title="Sobre mí" animar>
    <p class="intro">
      Detrás de Yoga Sana estoy yo, Natalia. Doy las clases, acompaño los talleres y las
      sesiones individuales, y soy quien te contesta al WhatsApp.
    </p>
    <a class="boton" href="/sobre-mi">Conóceme</a>
  </Section>

  <Section title="¿Te apetece empezar?" muted animar>
    <p class="intro">
      No necesitas experiencia previa: hay clases para todos los niveles y prácticas que se
      adaptan a tu ritmo. Escríbeme, me cuentas qué buscas y vemos por dónde empezar.
    </p>
    <WaButton {...CTAS.empezar} />
  </Section>

  <Section title="Escríbeme" animar>
    <p class="intro">
      Cualquier duda —horarios, precios, por dónde empezar— me la puedes preguntar
      directamente por WhatsApp. Contesto yo.
    </p>
    <WaButton {...CTAS.contacto} />
    <p class="alternativa apunte">
      ¿No usas WhatsApp? También estoy en Instagram, en <a
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener">{INSTAGRAM}</a
      >.
    </p>
  </Section>
</Base>

<style>
  .teasers {
    --min: 15rem;
    gap: 2.5rem 2rem;
  }

  .teasers li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
  }

  .teasers .teaser-cta {
    margin: auto 0 0;
    padding-top: 0.5rem;
  }

  .teasers p {
    margin: 0;
  }

  .alternativa {
    margin: 1.5rem 0 0;
  }
</style>
