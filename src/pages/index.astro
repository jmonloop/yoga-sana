---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import WaButton from '../components/WaButton.astro';
import { CTAS } from '../data/site';
import { ajuste, TAGLINE_POR_DEFECTO } from '../data/snapshot';

const tagline = ajuste('tagline', TAGLINE_POR_DEFECTO);
---

<Base
  title="Yoga Sana — Yoga en Catarroja (València)"
  description="Clases de yoga, talleres y Sanergía en Catarroja. Tu espacio para respirar, conectar y reconectar contigo."
>
  <Section eyebrow="Un lugar para ti" title="Yoga Sana">
    <p class="fade-up">
      {tagline}, en Catarroja (València).
    </p>
    <WaButton {...CTAS.empezar} />
  </Section>
</Base>
