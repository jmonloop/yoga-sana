---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import Section from '../components/Section.astro';
import Foto from '../components/Foto.astro';
import Pendiente from '../components/Pendiente.astro';
import WaButton from '../components/WaButton.astro';
import { CTAS } from '../data/site';
---

<Base
  title="Sanergía en Catarroja (València), presencial y online — Yoga Sana"
  description="Sanergía: técnica energética que armoniza cuerpo, mente y emociones a través de la imposición de manos. Sesiones presenciales en Catarroja u online."
>
  <Section eyebrow="Energía que equilibra">
    <div class="columna">
      <h1>Sanergía</h1>
      <p class="lead">
        Técnica energética que armoniza cuerpo, mente y emociones a través de la imposición
        de manos y la canalización de energía universal.
      </p>
      <div class="acciones">
        <WaButton {...CTAS.reservarSanergia} />
        <WaButton {...CTAS.reservarSanergiaOnline} variant="secondary" />
      </div>
      <p class="apunte">Puedes reservarla presencial en Catarroja u online.</p>
    </div>
  </Section>

  <Section title="Qué es la Sanergía" muted animar>
    <p class="lead">Un espacio para volver a conectar contigo.</p>
    <p>
      Sanergía es una experiencia de bienestar y crecimiento personal que invita a conectar
      con uno mismo desde una mirada de percepción y consciencia personal.
    </p>
    <p>
      Es una experiencia única para quienes sienten que están preparados para dar un paso
      hacia dentro, explorar nuevas sensaciones y profundizar en su relación consigo mismos y
      con la vida.
    </p>
    <p class="triada">
      Una experiencia.<br />Una apertura.<br />Una nueva forma de sentir.
    </p>

    <h3 class="titulo">¿Para quién puede ser?</h3>
    <p>Puede ser especialmente interesante para personas que:</p>
    <ul class="perfiles" role="list">
      <li>Sienten la necesidad de hacer una pausa y reconectar consigo mismas.</li>
      <li>Están atravesando una etapa de cambios.</li>
      <li>Buscan conocerse y comprenderse desde otra perspectiva.</li>
      <li>Tienen interés por el mundo energético y el crecimiento personal.</li>
      <li>Sienten curiosidad por experimentar algo diferente.</li>
      <li>Quieren dedicar un espacio a su bienestar interior.</li>
    </ul>
    <p>
      No necesitas saber nada previamente. Solo venir con curiosidad, presencia y disposición
      a vivir tu propia experiencia.
    </p>

    <h3 class="titulo">Un espacio para ti</h3>
    <p>
      No se trata de buscar respuestas fuera, sino de crear un espacio donde puedas
      escucharte, sentir y conectar.
    </p>
    <p class="triada">
      Cada experiencia es personal.<br />Cada proceso tiene su momento.<br />Y cada persona
      encuentra su propia manera de vivirlo.
    </p>
    <p class="intro">¿Sientes que es tu momento de conectar? Estoy aquí para acompañarte.</p>
    <WaButton {...CTAS.reservarSanergia} />
  </Section>

  <Section title="Espacio Raíz" animar>
    <Banda columnas="1fr 24rem">
      <p>Espacio Raíz es el acompañamiento individual de Yoga Sana.</p>
      <Pendiente>
        aquí va la descripción de Espacio Raíz (en qué consiste el acompañamiento, cómo se
        organiza y a quién va dirigido). No existe texto original de partida y no se ha
        escrito nada inventado.
      </Pendiente>
      <WaButton {...CTAS.espacioRaiz} />
      <Foto
        slot="foto"
        nombre="consciencia-corporal"
        sizes="(min-width: 60rem) 24rem, 92vw"
        alt="Mujer bailando con los brazos abiertos en una sala luminosa, captada en movimiento."
      />
    </Banda>
  </Section>

  <Section title="¿Te queda alguna duda?" muted animar>
    <p class="intro">
      Escríbeme por WhatsApp y te lo cuento sin compromiso, antes de reservar nada.
    </p>
    <WaButton {...CTAS.contacto} />
  </Section>
</Base>

<style>
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .triada {
    margin: 2rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.75rem);
    line-height: 1.5;
    color: var(--oliva-oscuro);
  }

  .titulo {
    margin: 3rem 0 1rem;
  }

  .perfiles {
    display: grid;
    gap: 0.75rem;
    max-width: var(--measure);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .perfiles li {
    position: relative;
    padding-left: 1.75rem;
  }

  .perfiles li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    background-color: var(--salvia);
    border-radius: var(--radius-circle);
  }
</style>
