---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import DescargarHorario from '../components/DescargarHorario.astro';
import Foto from '../components/Foto.astro';
import Horario from '../components/Horario.astro';
import Tarjetas from '../components/Tarjetas.astro';
import WaButton from '../components/WaButton.astro';
import { actividadesDe } from '../components/actividad';
import { CTAS } from '../data/site';
import {
  ajuste,
  NOTA_PIE_POR_DEFECTO,
  SNAPSHOT,
  TAGLINE_POR_DEFECTO,
} from '../data/snapshot';

const clases = actividadesDe(SNAPSHOT.actividades, 'yoga');
const otras = actividadesDe(SNAPSHOT.actividades, 'otras');

const tagline = ajuste('tagline', TAGLINE_POR_DEFECTO);
const notaPie = ajuste('nota_pie', NOTA_PIE_POR_DEFECTO);
const mes = ajuste('mes');
---

<Base
  title="Clases de yoga en Catarroja (València) — Yoga Sana"
  description="Hatha, dinámico, suave, adaptado, relajante e infantil: clases de yoga en Catarroja para todos los niveles, presenciales y online. Consulta el horario semanal."
>
  <Section>
    <div class="hero">
      <div class="hero-texto">
        <p class="hero-script">Respira. Conecta. Fluye.</p>
        <h1>Clases de yoga en Catarroja</h1>
        <p>{tagline}, en Catarroja (València).</p>
        <WaButton {...CTAS.empezar} />
      </div>
      <Foto
        nombre="clase-de-yoga"
        sizes="(min-width: 70rem) 32rem, (min-width: 60rem) 26rem, 92vw"
        alt="Mujer practicando una torsión de yoga sobre una esterilla, con un bloque de corcho al lado."
        eager
      />
    </div>
  </Section>

  <Section title="Las clases" muted>
    <p class="intro">
      Cada clase tiene su ritmo. Elige la que te resuene y escríbeme: te cuento horarios,
      precios y por dónde empezar.
    </p>
    <p class="intro modalidad">
      Todas las clases se pueden hacer presenciales en Catarroja u online, desde donde estés.
      Lo vemos por WhatsApp.
    </p>
    <Tarjetas actividades={clases} />
  </Section>

  {
    otras.length > 0 && (
      <Section title="Otras actividades">
        <p class="intro">Más propuestas que también puedes encontrar en Yoga Sana.</p>
        <Tarjetas actividades={otras} />
      </Section>
    )
  }

  <Section id="horario" title="Horario semanal" eyebrow={mes}>
    <p class="intro">
      Toca cualquier clase para escribirme por WhatsApp y reservar tu plaza. Si prefieres
      guardártelo, descarga el horario como imagen.
    </p>
    <Horario />
    <p class="intro nota">{notaPie}</p>
    <DescargarHorario />
  </Section>

  <Section title="Nuestro centro" muted>
    <p class="intro">
      Un espacio tranquilo en Catarroja para practicar sin prisa, con sitio de sobra para
      extender la esterilla.
    </p>
    <Foto
      nombre="centro-sala-amplia"
      sizes="(min-width: 70rem) 66rem, 92vw"
      alt="Vista amplia de la sala vacía, con suelo de madera clara, cortinas grises y la estantería de material a la izquierda."
    />
    <div class="galeria">
      <Foto
        nombre="centro-sala"
        sizes="(min-width: 70rem) 32rem, (min-width: 60rem) 29rem, (min-width: 41rem) 21rem, 92vw"
        alt="La sala con esterillas verdes extendidas sobre el suelo de madera y una lámpara de sal junto a la pared."
      />
      <Foto
        nombre="centro-materiales"
        sizes="(min-width: 70rem) 32rem, (min-width: 60rem) 29rem, (min-width: 41rem) 21rem, 92vw"
        alt="Estantería del centro con bolsters verdes, bloques de corcho, mantas y cojines de meditación."
      />
    </div>
  </Section>

  <Section title="¿Empezamos?">
    <p class="intro">
      Escríbeme por WhatsApp y te cuento horarios, precios y por dónde te viene mejor
      empezar.
    </p>
    <WaButton {...CTAS.empezar} />
  </Section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-texto {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .hero-script {
    margin: 0;
    font-family: var(--font-script);
    font-size: var(--font-size-display);
    line-height: 1.1;
    color: var(--oliva);
  }

  .hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: var(--tinta);
  }

  .hero p:not(.hero-script) {
    margin: 0;
    font-size: 1.125rem;
  }

  .intro {
    margin: 0 0 2rem;
  }

  .modalidad {
    color: var(--oliva-oscuro);
  }

  .nota {
    margin: 2rem 0;
    color: var(--oliva-oscuro);
  }

  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
