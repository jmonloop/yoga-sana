---
import WaButton from '../components/WaButton.astro';
import { CTAS, INSTAGRAM, INSTAGRAM_URL, waLink } from '../data/site';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.originPathname;
const canonical = new URL(path, Astro.site).href;
const year = new Date().getFullYear();

const NAV_ITEMS = [
  { label: 'Clases de Yoga', href: '/clases-de-yoga' },
  { label: 'Talleres y Experiencias', href: '/talleres-y-experiencias' },
  { label: 'Sanergía', href: '/sanergia' },
  { label: 'Online', href: '/online' },
  { label: 'Sobre mí', href: '/sobre-mi' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Yoga Sana, ir al inicio">
          <span class="brand-logo" data-logo-placeholder>
            <span class="brand-wordmark">Yoga Sana</span>
            <span class="brand-sub">Catarroja</span>
          </span>
        </a>

        <nav class="nav-menu" id="nav-menu" aria-label="Principal">
          <ul>
            {
              NAV_ITEMS.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="header-actions">
          <WaButton {...CTAS.empezar} compact />
          <button
            class="nav-toggle"
            id="nav-toggle"
            type="button"
            aria-controls="nav-menu"
            aria-expanded="false"
          >
            <span class="visually-hidden">Menú de navegación</span>
            <span class="nav-toggle-bars" aria-hidden="true"></span>
          </button>
        </div>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-brand">Yoga Sana · Catarroja (València)</p>
        <ul class="footer-contact">
          <li>
            <a
              href={waLink(CTAS.contacto.message)}
              aria-label={`WhatsApp: ${CTAS.contacto.ariaSuffix}`}
              target="_blank"
              rel="noopener">WhatsApp</a
            >
          </li>
          <li>
            <a
              href={INSTAGRAM_URL}
              aria-label={`${INSTAGRAM}: Instagram de Yoga Sana`}
              target="_blank"
              rel="noopener">{INSTAGRAM}</a
            >
          </li>
        </ul>
        <ul class="footer-legal">
          <li><a href="/aviso-legal">Aviso legal</a></li>
          <li><a href="/privacidad">Privacidad</a></li>
        </ul>
        <p class="footer-copy">© {year} Yoga Sana. Todos los derechos reservados.</p>
      </div>
    </footer>

    <script>
      const revealEntries = (
        entries: IntersectionObserverEntry[],
        observer: IntersectionObserver,
      ) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      };

      const initFadeUp = () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced || !('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('anim');
        const observer = new IntersectionObserver(revealEntries, {
          rootMargin: '0px 0px -10% 0px',
        });
        document.querySelectorAll('.fade-up').forEach((el) => observer.observe(el));
      };

      const initNav = () => {
        const toggle = document.getElementById('nav-toggle');
        const menu = document.getElementById('nav-menu');
        if (!toggle || !menu) return;
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          menu.toggleAttribute('data-open', open);
        };
        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
        );
        menu.addEventListener('click', (event) => {
          if (event.target instanceof HTMLAnchorElement) setOpen(false);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || toggle.getAttribute('aria-expanded') !== 'true') return;
          setOpen(false);
          toggle.focus();
        });
      };

      initNav();
      initFadeUp();
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        z-index: 10;
        padding: 0.75em 1.25em;
        background-color: var(--marfil);
        color: var(--tinta);
      }

      .skip-link:focus {
        left: var(--space-gutter);
        top: 0.5rem;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 5;
        background-color: var(--crema);
        border-bottom: 1px solid var(--salvia-tint);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        max-width: var(--max-width);
        margin-inline: auto;
        padding: 1rem var(--space-gutter);
      }

      .brand {
        display: inline-flex;
        text-decoration: none;
        color: var(--tinta);
      }

      .brand-logo {
        display: grid;
      }

      .brand-wordmark {
        font-family: var(--font-display);
        font-size: clamp(1rem, 4.6vw, 1.5rem);
        font-weight: 600;
        letter-spacing: var(--tracking-display);
        text-transform: uppercase;
        line-height: 1.1;
        white-space: nowrap;
      }

      .brand-sub {
        font-size: 0.6875rem;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--oliva-oscuro);
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .nav-menu ul {
        display: flex;
        gap: 1.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .nav-menu a {
        color: var(--tinta);
        font-size: 0.9375rem;
        letter-spacing: 0.04em;
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }

      .nav-menu a:hover,
      .nav-menu a:focus-visible {
        border-bottom-color: var(--oliva);
      }

      .nav-menu a[aria-current='page'] {
        color: var(--oliva-oscuro);
        font-weight: 500;
        border-bottom-color: var(--oliva-oscuro);
      }

      .nav-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        background: none;
        border: 1px solid var(--oliva);
        border-radius: var(--radius-pill);
        cursor: pointer;
      }

      .nav-toggle-bars {
        position: relative;
        display: block;
        width: 18px;
        height: 1.5px;
        background-color: var(--tinta);
      }

      .nav-toggle-bars::before,
      .nav-toggle-bars::after {
        content: '';
        position: absolute;
        left: 0;
        width: 18px;
        height: 1.5px;
        background-color: var(--tinta);
        transition: top 160ms ease, transform 160ms ease;
      }

      .nav-toggle-bars::before {
        top: -6px;
      }

      .nav-toggle-bars::after {
        top: 6px;
      }

      .nav-toggle[aria-expanded='true'] .nav-toggle-bars {
        background-color: transparent;
      }

      .nav-toggle[aria-expanded='true'] .nav-toggle-bars::before {
        top: 0;
        transform: rotate(45deg);
      }

      .nav-toggle[aria-expanded='true'] .nav-toggle-bars::after {
        top: 0;
        transform: rotate(-45deg);
      }

      .site-footer {
        background-color: var(--marfil);
        border-top: 1px solid var(--salvia-tint);
      }

      .footer-inner {
        max-width: var(--max-width);
        margin-inline: auto;
        padding: 3rem var(--space-gutter);
        display: grid;
        gap: 0.75rem;
      }

      .footer-inner ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .footer-inner a {
        color: var(--tinta);
      }

      .footer-brand {
        margin: 0;
        font-size: 1.125rem;
        font-family: var(--font-display);
        letter-spacing: var(--tracking-display);
        text-transform: uppercase;
      }

      .footer-copy {
        margin: 1rem 0 0;
        font-size: 0.875rem;
        color: var(--oliva-oscuro);
      }

      @media (max-width: 1023px) {
        .header-inner {
          flex-wrap: wrap;
        }

        .nav-menu {
          width: 100%;
        }

        .nav-menu ul {
          flex-direction: column;
          gap: 1rem;
        }

        html.js .nav-menu {
          display: none;
          position: absolute;
          inset-inline: 0;
          top: 100%;
          width: auto;
          padding: 1rem var(--space-gutter) 1.5rem;
          background-color: var(--crema);
          border-bottom: 1px solid var(--salvia-tint);
        }

        html.js .nav-menu[data-open] {
          display: block;
        }

        html:not(.js) .nav-toggle {
          display: none;
        }

        html:not(.js) .site-header {
          position: static;
        }
      }

      @media (max-width: 479px) {
        .header-inner {
          gap: 0.5rem;
        }
      }

      @media (min-width: 1024px) {
        .nav-toggle {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .nav-toggle-bars::before,
        .nav-toggle-bars::after {
          transition: none;
        }
      }
    </style>
  </body>
</html>
