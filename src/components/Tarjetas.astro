---
import ActividadCard from './ActividadCard.astro';
import type { Actividad } from '../data/sheet';
import type { Enlace } from '../data/site';

interface Props {
  actividades: Actividad[];
  enlaces?: Partial<Record<string, Enlace>>;
}

const { actividades, enlaces } = Astro.props;
---

{
  actividades.length > 0 && (
    <ul class="rejilla" role="list">
      {actividades.map((actividad) => (
        <li>
          <ActividadCard actividad={actividad} enlace={enlaces?.[actividad.nombre]} />
        </li>
      ))}
    </ul>
  )
}
