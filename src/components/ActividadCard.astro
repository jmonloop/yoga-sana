---
import Icono from './Icono.astro';
import WaButton from './WaButton.astro';
import { actividadCta } from './actividad';
import type { Actividad } from '../data/sheet';

interface Props {
  actividad: Actividad;
}

const { actividad } = Astro.props;
const cta = actividadCta(actividad);
const etiqueta = actividad.etiqueta.trim();
const descripcion = actividad.descripcion.trim();
---

<article class="tarjeta fade-up">
  <Icono icono={actividad.icono} size={72} />
  {etiqueta && <p class="etiqueta">{etiqueta}</p>}
  <h3 class="nombre">{actividad.nombre}</h3>
  {descripcion && <p class="descripcion">{descripcion}</p>}
  <div class="accion">
    <WaButton {...cta} variant="secondary" />
  </div>
</article>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    height: 100%;
    padding: 2rem 1.75rem;
    background-color: var(--marfil);
    border: 1px solid var(--salvia-tint);
    border-radius: var(--radius-card);
  }

  .etiqueta {
    margin: 0.25rem 0 0;
    padding: 0.35em 0.9em;
    background-color: var(--salvia-tint);
    border-radius: var(--radius-pill);
    color: var(--tinta);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .nombre {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
    color: var(--tinta);
    overflow-wrap: anywhere;
  }

  .descripcion {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--tinta);
    overflow-wrap: anywhere;
  }

  .accion {
    margin-top: auto;
    padding-top: 0.75rem;
  }
</style>
