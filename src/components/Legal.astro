---
import Section from './Section.astro';

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<Section>
  <div class="legal">
    <h1>{titulo}</h1>
    <slot />
  </div>
</Section>

<style>
  .legal :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--tinta);
  }

  .legal :global(p) {
    margin: 0 0 1rem;
  }

  .legal :global(.lead) {
    margin-top: 1.5rem;
  }

  .legal :global(.actualizado) {
    margin-top: 3rem;
  }
</style>
