---
import { altoRenderizado, imagen, rutaImagen } from '../data/imagenes';

interface Props {
  nombre: string;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { nombre, alt, sizes, eager = false } = Astro.props;

const foto = imagen(nombre);
const { fallback, widths } = foto;
const alto = altoRenderizado(foto);
const nativo = Math.max(...widths);

const srcset = (extension: string): string =>
  widths.map((ancho) => `${rutaImagen(foto, ancho, extension)} ${ancho}w`).join(', ');
---

<picture style={`--foto-max: ${nativo}px`}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={rutaImagen(foto, fallback, 'jpg')}
    alt={alt}
    width={fallback}
    height={alto}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>

<style>
  picture {
    display: block;
  }

  img {
    width: 100%;
    max-width: min(100%, var(--foto-max));
    height: auto;
    border-radius: var(--radius-card);
  }
</style>
