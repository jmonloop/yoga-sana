---
import { waLink } from '../data/site';

interface Props {
  message: string;
  label: string;
  ariaSuffix: string;
  variant?: 'primary' | 'secondary';
  compact?: boolean;
}

const { message, label, ariaSuffix, variant = 'primary', compact = false } = Astro.props;
---

<a
  class:list={['boton', variant, { compact }]}
  href={waLink(message)}
  aria-label={`${label}: ${ariaSuffix}`}
  target="_blank"
  rel="noopener"
>
  {label}
</a>

<style>
  .primary {
    background-color: var(--oliva-oscuro);
    color: var(--marfil);
  }

  .primary:hover,
  .primary:focus-visible {
    background-color: var(--tinta);
    border-color: var(--tinta);
  }

  .compact {
    padding: 0.7em 0.9em;
    white-space: nowrap;
    font-size: clamp(0.625rem, 2.2vw, 0.8125rem);
    letter-spacing: 0.02em;
  }
</style>
