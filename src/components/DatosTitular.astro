---
import { CTAS, DOMICILIO, NIF, TITULAR, waLink, WHATSAPP_VISIBLE } from '../data/site';
import { origenDe } from '../data/seo';

const dominio = new URL(origenDe(Astro.site)).host;
---

<dl class="datos">
  <dt>Titular</dt>
  <dd>{TITULAR}</dd>

  <dt>NIF</dt>
  <dd>{NIF}</dd>

  <dt>Domicilio</dt>
  <dd>{DOMICILIO}</dd>

  <dt>Contacto</dt>
  <dd>
    <a
      href={waLink(CTAS.contacto.message)}
      aria-label={`WhatsApp: ${CTAS.contacto.ariaSuffix}`}
      target="_blank"
      rel="noopener">WhatsApp {WHATSAPP_VISIBLE}</a
    >
  </dd>

  <dt>Sitio web</dt>
  <dd>{dominio}</dd>
</dl>

<style>
  .datos {
    display: grid;
    gap: 0.35rem 1.5rem;
    max-width: var(--measure);
    margin: 0 0 2rem;
  }

  dt {
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    color: var(--oliva-oscuro);
  }

  dd {
    margin: 0 0 0.75rem;
  }

  @media (min-width: 40rem) {
    .datos {
      grid-template-columns: 9rem 1fr;
      align-items: baseline;
    }

    dd {
      margin-bottom: 0.25rem;
    }
  }
</style>
