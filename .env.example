# Published Google Sheet that feeds the horarios and the activity cards.
# Nothing here is secret: File > Share > Publish to the web makes each tab
# publicly readable as CSV by URL. Never put private data in that spreadsheet.
#
# Read by scripts/fetch-snapshot.mjs at build time (process.env) and by
# src/data/live-refresh.ts in the browser (import.meta.env).
#
# Set all four or none. With none set the build falls back to the seed/ CSVs
# and the browser never calls Google at all; with only some set the build
# fails loudly rather than shipping stale seed data.

# The document id, taken from the address bar while editing the Sheet:
#   https://docs.google.com/spreadsheets/d/<PUBLIC_SHEET_ID>/edit#gid=0
# Not the 2PACX-... token. The "Publish to the web" dialog hands out a
# different URL shape that carries a publish token instead:
#   https://docs.google.com/spreadsheets/d/e/2PACX-.../pub?output=csv&gid=0
# csvUrl() in src/data/sheet-config.ts builds the /d/<id>/pub form, so paste
# the id from the edit URL. Whoever creates the Sheet must confirm this once:
# run `pnpm snapshot` with the four values set and check it does not 404.
PUBLIC_SHEET_ID=

# One gid per tab, read off the end of the edit URL with that tab selected.
PUBLIC_SHEET_GID_ACTIVIDADES=
PUBLIC_SHEET_GID_HORARIOS=
PUBLIC_SHEET_GID_AJUSTES=
